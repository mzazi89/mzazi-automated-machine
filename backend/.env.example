# ---------------------------------------------------------------------------
# MZAZI TECH AUTOMATED MACHINE — backend environment example
# Copy to .env and fill in real values. NEVER commit the filled .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
# Public HTTPS base URL of this API (used in callback URLs and docs)
PUBLIC_BASE_URL=https://api.example.com

# --- Neon PostgreSQL -------------------------------------------------------
# Neon connection string. Always use sslmode=require in production.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/mzazi?sslmode=require
PGSSL=require
DB_POOL_MAX=10

# --- Authentication --------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-48-random-bytes-base64
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=30d

# Bootstrap administrator (used once by `npm run seed`, then rotate out of env)
BOOTSTRAP_ADMIN_EMAIL=admin@mzazitech.example
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_NAME=MZAZI Administrator

# --- M-Pesa Daraja ---------------------------------------------------------
# Values come from the Safaricom Daraja portal.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Callback URL must be public HTTPS. The secret path segment protects it.
MPESA_CALLBACK_URL=https://api.example.com/api/v1/payments/mpesa/callback
MPESA_CALLBACK_SECRET=replace-with-a-long-random-path-secret
# Optional: verify a callback by querying the transaction status API too.
MPESA_VERIFY_WITH_QUERY=true
MPESA_TIMEOUT_SECONDS=60

# --- Runtime behaviour -----------------------------------------------------
# TEST_MODE=true lets /payments/test/simulate settle transactions without money.
# MUST be false in production.
TEST_MODE=true
# Refuse to create a second active sale for the same number+bundle inside this window.
DUPLICATE_WINDOW_MINUTES=15
ALLOWED_ORIGINS=http://localhost:3000

# --- CORS / logging --------------------------------------------------------
LOG_LEVEL=info
